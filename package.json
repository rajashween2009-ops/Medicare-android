{
  "name": "medicare-elderly-medication-companion",
  "version": "1.0.0",
  "private": true,
  "description": "Senior-friendly daily medication companion",
  "scripts": {
    "android:add": "cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:debug": "cd android && gradlew.bat assembleDebug",
    "android:release": "cd android && gradlew.bat bundleRelease",
    "build": "esbuild www/native-notifications.js --bundle --platform=browser --format=iife --outfile=www/native-notifications.bundle.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/local-notifications": "^8.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "esbuild": "^0.27.0"
  }
}
